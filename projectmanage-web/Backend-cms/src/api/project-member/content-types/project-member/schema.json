{
  "kind": "collectionType",
  "collectionName": "project_members",
  "info": {
    "singularName": "project-member",
    "pluralName": "project-members",
    "displayName": "ProjectMember"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "role_in_project": {
      "type": "string",
      "maxLength": 50,
      "required": true
    },
    "join_date": {
      "type": "datetime",
      "required": true
    },
    "project_id_number": {
      "type": "integer",
      "required": true
    },
    "user_id_in_project": {
      "type": "integer",
      "required": true
    },
    "project_document_id": {
      "type": "string",
      "maxLength": 255,
      "required": true
    },
    "project_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::project.project"
    },
    "user_ids": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "project_member"
    },
    "role": {
      "type": "enumeration",
      "default": "member",
      "enum": [
        "owner",
        "admin",
        "member"
      ]
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "project_member"
    },
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "memberships"
    }
  }
}
