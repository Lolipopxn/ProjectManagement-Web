{
  "kind": "collectionType",
  "collectionName": "chats",
  "info": {
    "singularName": "chat",
    "pluralName": "chats",
    "displayName": "Chat"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "project_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::project.project"
    },
    "message_content": {
      "type": "text",
      "required": true
    },
    "sent_by_user_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "sent_at": {
      "type": "datetime",
      "required": true
    }
  }
}
