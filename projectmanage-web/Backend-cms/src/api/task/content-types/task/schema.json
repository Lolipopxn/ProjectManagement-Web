{
  "kind": "collectionType",
  "collectionName": "tasks",
  "info": {
    "singularName": "task",
    "pluralName": "tasks",
    "displayName": "Task"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "project_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::project.project"
    },
    "task_name": {
      "type": "string",
      "maxLength": 255,
      "required": true
    },
    "description": {
      "type": "text"
    },
    "assigned_to_user_ids": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "task_id"
    },
    "project_document_id": {
      "type": "string",
      "maxLength": 255,
      "required": true
    },
    "project_id_number": {
      "type": "integer",
      "required": true
    },
    "assigned_to_user_ids_number": {
      "type": "integer",
      "required": false
    },
    "due_date": {
      "type": "datetime"
    },
    "task_status": {
      "type": "string",
      "maxLength": 50,
      "required": true
    },
    "board_name": {
      "type": "string"
    },
    "pos_x": {
      "type": "decimal"
    },
    "pos_y": {
      "type": "decimal"
    },
    "is_left": {
      "type": "boolean",
      "default": true
    },
    "begin_date": {
      "type": "datetime"
    },
    "task_type": {
      "type": "string"
    },
    "task_color": {
      "type": "string"
    },
    "task_status_histories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::task-status-history.task-status-history",
      "mappedBy": "task"
    },
    "latitude": {
      "type": "float"
    },
    "longitude": {
      "type": "float"
    },
    "address": {
      "type": "string"
    }
  }
}
