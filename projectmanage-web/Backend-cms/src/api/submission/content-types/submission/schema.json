{
  "kind": "collectionType",
  "collectionName": "submissions",
  "info": {
    "singularName": "submission",
    "pluralName": "submissions",
    "displayName": "Submission"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "task_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::task.task"
    },
    "submitted_by_user_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "task_document_id": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "task_id_number": {
      "type": "integer",
      "required": true
    },
    "submitted_by_user_id_number": {
      "type": "integer",
      "required": true
    },
    "submission_date": {
      "type": "datetime"
    },
    "file_urls": {
      "type": "json"
    },
    "submission_description": {
      "type": "text"
    },
    "comments": {
      "type": "text"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "cancelled_at": {
      "type": "datetime"
    }
  }
}
